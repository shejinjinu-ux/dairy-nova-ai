# ==============================================================================
# DAIRY NOVA AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env / .env.local)
# ==============================================================================
#
# IMPORTANT:
# For local development, copy this file to `.env.local` or `.env` and fill in
# your real SMS Gateway and Gemini AI credentials.
#
# DO NOT commit your `.env` or `.env.local` file containing secrets to GitHub.
#

# ------------------------------------------------------------------------------
# 0. FASTAPI BACKEND API BASE URL
# ------------------------------------------------------------------------------
# Local Development:
# Points to local FastAPI backend instance (default fallback in dev):
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# VITE_API_URL=http://127.0.0.1:8000

# Production / Vercel Deployment:
# In production (e.g. Vercel), set VITE_API_BASE_URL in Project Settings > Environment Variables:
# VITE_API_BASE_URL=https://<your-deployed-fastapi-backend-url>/api/v1
# (Production frontend requires VITE_API_BASE_URL and will NOT fall back to localhost)


# ------------------------------------------------------------------------------
# 1. REAL MOBILE SMS GATEWAY CONFIGURATION (Select ANY ONE provider)
# ------------------------------------------------------------------------------

# Option A: Fast2SMS (Recommended for India - Quick transactional OTP setup)
# Get your API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Option B: Twilio (Global SMS Gateway)
# Get credentials from: https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Option C: MSG91 (Indian Enterprise Gateway)
# Get credentials from: https://msg91.com/
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=


# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI ADVISORY & CHAT (Server-Side Proxy)
# ------------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
